# AI analysis (optional). Server-side only; never expose these to the browser.
# Leave QA_VISION_AI_PROVIDER unset to disable AI analysis.
# QA_VISION_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional model override (anthropic default: claude-opus-5-5)
# QA_VISION_AI_MODEL=

# Or any OpenAI-compatible API (for example Grok):
# QA_VISION_AI_PROVIDER=openai-compatible
# QA_VISION_AI_BASE_URL=https://api.x.ai/v1
# QA_VISION_AI_API_KEY=your-api-key-here
# QA_VISION_AI_MODEL=your-model-name
