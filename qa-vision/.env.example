# QA Vision configuration. Copy to .env and fill in; never commit real values.
# All of these are server-side only; never expose them to the browser.

# --- Storage and secrets ---
# Key that encrypts stored login credentials. If unset, a key file is generated in the data directory.
# QA_VISION_SECRET_KEY=replace-with-a-long-random-string
# Data directory for the SQLite database and key file (default: ./data)
# QA_VISION_DATA_DIR=./data

# --- Server ---
# Dashboard port for server.js (default 3001)
# QA_VISION_PORT=3001
# Next.js distDir override (the UI test sets .next-ui)
# QA_VISION_DIST_DIR=.next
# Restrict target hosts, comma-separated suffix match
# QA_VISION_ALLOWED_HOSTS=example.com,localhost
# Per-comparison time budget in milliseconds (mainly for tests)
# QA_VISION_COMPARE_BUDGET_MS=60000

# --- AI analysis (optional) ---
# Leave QA_VISION_AI_PROVIDER unset to disable AI analysis.
# QA_VISION_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional model override (anthropic default: claude-opus-5-5)
# QA_VISION_AI_MODEL=

# Or any OpenAI-compatible API (for example Grok):
# QA_VISION_AI_PROVIDER=openai-compatible
# QA_VISION_AI_BASE_URL=https://api.x.ai/v1
# QA_VISION_AI_API_KEY=your-api-key-here
# QA_VISION_AI_MODEL=your-model-name

# --- Tests only ---
# Enables the real-server PostgreSQL database-check test (read-only role recommended)
# QA_TEST_PG_URL=postgres://user:password@localhost:5432/dbname
