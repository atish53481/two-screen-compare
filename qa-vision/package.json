{
  "name": "qa-vision",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "playwright install --with-deps",
    "start:all": "concurrently \"npm --prefix ../sample-dev run dev\" \"npm --prefix ../sample-prod run dev\" \"npm run dev\" --names \"DEV,PROD,QA\" --prefix-colors \"green,blue,cyan\"",
    "start:real": "node server.js",
    "dev:real": "node server.js",
    "build:engine": "node scripts/build-engine.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/run-e2e.js",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.475.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
